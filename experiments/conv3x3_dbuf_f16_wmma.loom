// 3x3 convolution, pad 1, stride 1 or 2, as an implicit GEMM on the 64-wide-N WMMA
// staged-LDS matmul from dinov3-loom. Everything about that kernel is kept --
// the W staging, the k-loop, the LDS budget, the epilogue -- except the one load
// that stages a row of A: that load is now the im2col gather, so the [M][K]
// matrix never exists.
//
//   C[(b*Ho + yo)*Wo + xo, n] = bias[n] + sum_k A_gathered[row, k] * W[n, k]
//     with k = (dy*3 + dx)*Cin_pad + c, reading in[(b*H + yi)*W + xi, c] for
//     yi = yo*stride + dy - 1, xi = xo*stride + dx - 1, zero outside the image.
//
// A is NHWC f16 [B*H*W][Cin_stride]; W is [Cout_pad][K_pad] f16 in that k order
// (tools/export_weights.py); C is NHWC f16 [B*Ho*Wo][n_size]. f32 accumulate.
// Cin_pad and Cin_stride are multiples of 8: each lane gathers one row x
// vector<8xf16> per k-step, so a packet never straddles a tap.
//
// EXPERIMENT: double-buffered LDS stages with register prefetch. Two A/W stage
// sets alternate: each 64-wide iteration barriers, gathers k+32 into registers,
// multiplies stage 0, stores into stage 1, barriers, gathers k+64, multiplies
// stage 1, stores into stage 0 -- one barrier per 32-wide step instead of two.
// K is walked in steps of 64; a trailing half past K multiplies zeros.
//
amdgpu.target<gfx11-generic> @scrfd_conv3x3_dbuf_f16_wmma_gfx11 {subgroup_size = 32}

// Input height/width (NHWC, Cin_stride channels), stride, gather width and row
// stride. k_size is K_pad = 9*Cin_pad rounded to 32; the gather zero-fills the tail.
config.decl @scrfd.conv3x3_dbuf_f16_wmma.height : %value: index where [range(%value, 2, 4096), mul(%value, 2)]

config.decl @scrfd.conv3x3_dbuf_f16_wmma.width : %value: index where [range(%value, 2, 4096), mul(%value, 2)]

config.decl @scrfd.conv3x3_dbuf_f16_wmma.stride : %value: index where [range(%value, 1, 2)]

config.decl @scrfd.conv3x3_dbuf_f16_wmma.cin_pad : %value: index where [range(%value, 8, 1024), mul(%value, 8)]

// Physical channel stride of the input rows: the width its producer wrote,
// which is that conv's Cout_pad (64-aligned), or 4 for the stem's converted
// image. The gather reads only c < cin_pad inside each row, so the MMA work is
// 9*cin_pad, not 9*cin_stride -- for an 88-channel tensor stored 128 wide that
// is the difference between K=800 and K=1152.
config.decl @scrfd.conv3x3_dbuf_f16_wmma.cin_stride : %value: index where [range(%value, 8, 1024), mul(%value, 8)]

config.decl @scrfd.conv3x3_dbuf_f16_wmma.k_size : %value: index where [range(%value, 32, 16384), mul(%value, 32)]

config.decl @scrfd.conv3x3_dbuf_f16_wmma.n_size : %value: index where [range(%value, 64, 8192), mul(%value, 64)]

kernel.def target(@scrfd_conv3x3_dbuf_f16_wmma_gfx11) export("scrfd_conv3x3_dbuf_f16_wmma") @scrfd_conv3x3_dbuf_f16_wmma(%m_size: index) {
  %c1 = index.constant 1 : index
  %c63 = index.constant 63 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %n_size0 = config.get @scrfd.conv3x3_dbuf_f16_wmma.n_size : index
  %m_rounded = index.add %m_size, %c63 : index
  %m_tiles = index.div %m_rounded, %c64 : index
  %n_tiles = index.div %n_size0, %c64 : index
  kernel.launch.config workgroups(%n_tiles, %m_tiles, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%m_size: index, %a: buffer, %w: buffer, %bias: buffer, %c: buffer) {
  %k_size0 = config.get @scrfd.conv3x3_dbuf_f16_wmma.k_size : index
  %n_size0 = config.get @scrfd.conv3x3_dbuf_f16_wmma.n_size : index
  %k_size = index.assume %k_size0 [range(%k_size0, 32, 8192), mul(%k_size0, 32)] : index
  %n_size = index.assume %n_size0 [range(%n_size0, 64, 8192), mul(%n_size0, 64)] : index
  %height = config.get @scrfd.conv3x3_dbuf_f16_wmma.height : index
  %width = config.get @scrfd.conv3x3_dbuf_f16_wmma.width : index
  %stride = config.get @scrfd.conv3x3_dbuf_f16_wmma.stride : index
  %cin_pad = config.get @scrfd.conv3x3_dbuf_f16_wmma.cin_pad : index
  %cin_stride = config.get @scrfd.conv3x3_dbuf_f16_wmma.cin_stride : index

  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c40 = index.constant 40 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %lds_bytes = index.constant 20480 : offset
  %w0_offset = index.constant 5120 : offset
  %a1_offset = index.constant 10240 : offset
  %w1_offset = index.constant 15360 : offset
  %wave_result_bytes = index.constant 1024 : offset
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %zero_f32x8 = vector.constant 0.0 : vector<8xf32>
  %zero_f16x4 = vector.constant 0.0 : vector<4xf16>
  %zero_f16x8 = vector.constant 0.0 : vector<8xf16>

  %tile_n_id = kernel.workgroup.id<x> : index
  %tile_m_id = kernel.workgroup.id<y> : index
  %workitem = kernel.workitem.id<x> : index
  %subgroup0 = kernel.subgroup.id : index
  %subgroup = index.assume %subgroup0 [range(%subgroup0, 0, 7)] : index
  %lane = kernel.subgroup.lane.id : index

  %wave_m = index.div %subgroup, %c2 : index
  %wave_n = index.rem %subgroup, %c2 : index
  %wave_row = index.mul %wave_m, %c16 : index
  %wave_col = index.mul %wave_n, %c32 : index
  %wave_col1 = index.add %wave_col, %c16 : index
  %base_m = index.mul %tile_m_id, %c64 : index
  %base_n = index.mul %tile_n_id, %c64 : index

  %a_global = buffer.assume.memory_space<global> %a : buffer
  %w_global = buffer.assume.memory_space<global> %w : buffer
  %bias_global = buffer.assume.memory_space<global> %bias : buffer
  %c_global = buffer.assume.memory_space<global> %c : buffer
  // A is the NHWC input [B*H*W][Cin_stride]; the [M][K] matrix is never formed.
  // M = B*Ho*Wo is a launch argument -- bounded here, never with `where`.
  %c3 = index.constant 3 : index
  %c9 = index.constant 9 : index
  %m_bounded = index.assume %m_size [range(%m_size, 1, 16777216)] : index
  %ho = index.div %height, %stride : index
  %wo = index.div %width, %stride : index
  %plane = index.mul %ho, %wo : index
  %images = index.div %m_bounded, %plane : index
  %in_rows_per_image = index.mul %height, %width : index
  %in_rows_total = index.mul %images, %in_rows_per_image : index
  %k_real = index.mul %cin_pad, %c9 : index
  %c_limit = index.sub %cin_pad, %c8 : index
  %a_view = buffer.view %a_global[%c0_offset] : buffer -> view<[%in_rows_total]x[%cin_stride]xf16>
  %w_view = buffer.view %w_global[%c0_offset] : buffer -> view<[%n_size]x[%k_size]xf16>
  %bias_view = buffer.view %bias_global[%c0_offset] : buffer -> view<[%n_size]xf32>
  %c_view = buffer.view %c_global[%c0_offset] : buffer -> view<[%m_size]x[%n_size]xf16>

  %lds = buffer.alloca<workgroup> align(16) %lds_bytes : buffer
  %a_stage_view = buffer.view %lds[%c0_offset] : buffer -> view<64x40xf16>
  %w_stage_view = buffer.view %lds[%w0_offset] : buffer -> view<64x40xf16>
  %a_stage_view1 = buffer.view %lds[%a1_offset] : buffer -> view<64x40xf16>
  %w_stage_view1 = buffer.view %lds[%w1_offset] : buffer -> view<64x40xf16>
  // The rhs fragment wants logical [k][n]; the staged weight tile is physically
  // [n][k] with a 40-element row, so a strided layout reads it transposed.
  %w_fragment_layout = encoding.layout.strided [1, %c40] : encoding<layout>
  %w_fragment_view = buffer.view %lds[%w0_offset] : buffer -> view<32x64xf16, %w_fragment_layout>
  %w_fragment_view1 = buffer.view %lds[%w1_offset] : buffer -> view<32x64xf16, %w_fragment_layout>
  %wave_result_offset = index.scale %subgroup, %wave_result_bytes : index, offset -> offset
  %result_view = buffer.view %lds[%wave_result_offset] : buffer -> view<16x16xf32>

  %load_packet = index.rem %workitem, %c4 : index
  %load_k = index.mul %load_packet, %c8 : index
  %load_row0 = index.div %workitem, %c4 : index
  %load_row = index.assume %load_row0 [range(%load_row0, 0, 63)] : index

  %acc_init0 = vector.fragment<init> %zero_f32x8 shape [%m, %n] : vector<8xf32>
  %acc_init1 = vector.fragment<init> %zero_f32x8 shape [%m, %n] : vector<8xf32>

  // Hoisted out of the k-loop: this workitem stages tile row load_row -- one
  // output pixel -- for every k, so its (image, y0, x0) is decomposed once here;
  // per k only the tap and channel of the column remain.
  %h_m0 = index.add %base_m, %load_row : index
  %h_ok0 = index.cmp ult, %h_m0, %m_bounded : index
  %h_safe0 = scf.select %h_ok0, %h_m0, %c0 : index
  %h_b0 = index.assume %h_safe0 [lt(%h_safe0, %m_bounded)] : index
  %h_img0 = index.div %h_b0, %plane : index
  %h_pix0 = index.rem %h_b0, %plane : index
  %h_yo0 = index.div %h_pix0, %wo : index
  %h_xo0 = index.rem %h_pix0, %wo : index
  %h_ys0 = index.mul %h_yo0, %stride : index
  %h_xs0 = index.mul %h_xo0, %stride : index
  %h_rows0 = index.mul %h_img0, %height : index

  // Step 0 into stage 0 before the loop.
  %source_k_first = index.add %c0, %load_k : index
  %row_first = index.add %load_row, %c0 : index
  %source_m_first = index.add %base_m, %row_first : index
  %m_in_range_first = index.cmp ult, %source_m_first, %m_size : index
  // Implicit im2col: this row of A is output pixel (b, yo, xo) and this
  // column is tap (dy, dx) of channel c. Zero outside the image and beyond
  // 9*Cin_pad. Same address arithmetic as kernels/im2col_f16.loom, which
  // is tested exactly against NumPy.
  %in_k_first = index.cmp ult, %source_k_first, %k_real : index
  %gathers_first = scalar.andi %m_in_range_first, %in_k_first : i1
  %a_values_first = scf.if %gathers_first -> (vector<8xf16>) {
    %ys_first = index.add %h_ys0, %c0 : index
    %xs_first = index.add %h_xs0, %c0 : index
    %image_rows_first = index.add %h_rows0, %c0 : index
    %tap_first = index.div %source_k_first, %cin_pad : index
    %c_first = index.rem %source_k_first, %cin_pad : index
    %dy_first = index.div %tap_first, %c3 : index
    %dx_first = index.rem %tap_first, %c3 : index
    // Clamp before subtracting: y0 = yo*stride + dy is never negative; the
    // tap is inside iff 1 <= y0 <= H, and only then is yi = y0 - 1 formed.
    %y0_first = index.add %ys_first, %dy_first : index
    %x0_first = index.add %xs_first, %dx_first : index
    %y_low_first = index.cmp uge, %y0_first, %c1 : index
    %y_high_first = index.cmp ule, %y0_first, %height : index
    %x_low_first = index.cmp uge, %x0_first, %c1 : index
    %x_high_first = index.cmp ule, %x0_first, %width : index
    %y_ok_first = scalar.andi %y_low_first, %y_high_first : i1
    %x_ok_first = scalar.andi %x_low_first, %x_high_first : i1
    %inside_first = scalar.andi %y_ok_first, %x_ok_first : i1
    %loaded_first = scf.if %inside_first -> (vector<8xf16>) {
      %yi0_first = index.sub %y0_first, %c1 : index
      %xi0_first = index.sub %x0_first, %c1 : index
      %yi_first = index.assume %yi0_first [lt(%yi0_first, %height)] : index
      %xi_first = index.assume %xi0_first [lt(%xi0_first, %width)] : index
      %row_y0_first = index.add %image_rows_first, %yi_first : index
      %row_yw_first = index.mul %row_y0_first, %width : index
      %in_row0_first = index.add %row_yw_first, %xi_first : index
      %in_row_first = index.assume %in_row0_first [lt(%in_row0_first, %in_rows_total)] : index
      %c_col_first = index.assume %c_first [le(%c_first, %c_limit), mul(%c_first, 8)] : index
      %v_first = vector.load %a_view[%in_row_first, %c_col_first] : view<[%in_rows_total]x[%cin_stride]xf16> -> vector<8xf16>
      scf.yield %v_first : vector<8xf16>
    } else {
      scf.yield %zero_f16x8 : vector<8xf16>
    }
    scf.yield %loaded_first : vector<8xf16>
  } else {
    scf.yield %zero_f16x8 : vector<8xf16>
  }
  %source_n_first = index.add %base_n, %row_first : index
  %w_in_k_first = index.cmp ult, %source_k_first, %k_size : index
  %w_values_first = scf.if %w_in_k_first -> (vector<8xf16>) {
    %w_k_first = index.assume %source_k_first [lt(%source_k_first, %k_size)] : index
    %w_loaded_first = vector.load %w_view[%source_n_first, %w_k_first] : view<[%n_size]x[%k_size]xf16> -> vector<8xf16>
    scf.yield %w_loaded_first : vector<8xf16>
  } else {
    scf.yield %zero_f16x8 : vector<8xf16>
  }
  vector.store %a_values_first, %a_stage_view[%load_row, %load_k] : vector<8xf16>, view<64x40xf16>
  vector.store %w_values_first, %w_stage_view[%load_row, %load_k] : vector<8xf16>, view<64x40xf16>
  %acc0, %acc1 = scf.for %k_base = [%c0 to %k_size step %c64](%run0 = %acc_init0 : vector<8xf32>, %run1 = %acc_init1 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>) {
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %k_mid = index.add %k_base, %c32 : index
    %source_k_mid = index.add %k_mid, %load_k : index
    %row_mid = index.add %load_row, %c0 : index
    %source_m_mid = index.add %base_m, %row_mid : index
    %m_in_range_mid = index.cmp ult, %source_m_mid, %m_size : index
    // Implicit im2col: this row of A is output pixel (b, yo, xo) and this
    // column is tap (dy, dx) of channel c. Zero outside the image and beyond
    // 9*Cin_pad. Same address arithmetic as kernels/im2col_f16.loom, which
    // is tested exactly against NumPy.
    %in_k_mid = index.cmp ult, %source_k_mid, %k_real : index
    %gathers_mid = scalar.andi %m_in_range_mid, %in_k_mid : i1
    %a_values_mid = scf.if %gathers_mid -> (vector<8xf16>) {
      %ys_mid = index.add %h_ys0, %c0 : index
      %xs_mid = index.add %h_xs0, %c0 : index
      %image_rows_mid = index.add %h_rows0, %c0 : index
      %tap_mid = index.div %source_k_mid, %cin_pad : index
      %c_mid = index.rem %source_k_mid, %cin_pad : index
      %dy_mid = index.div %tap_mid, %c3 : index
      %dx_mid = index.rem %tap_mid, %c3 : index
      // Clamp before subtracting: y0 = yo*stride + dy is never negative; the
      // tap is inside iff 1 <= y0 <= H, and only then is yi = y0 - 1 formed.
      %y0_mid = index.add %ys_mid, %dy_mid : index
      %x0_mid = index.add %xs_mid, %dx_mid : index
      %y_low_mid = index.cmp uge, %y0_mid, %c1 : index
      %y_high_mid = index.cmp ule, %y0_mid, %height : index
      %x_low_mid = index.cmp uge, %x0_mid, %c1 : index
      %x_high_mid = index.cmp ule, %x0_mid, %width : index
      %y_ok_mid = scalar.andi %y_low_mid, %y_high_mid : i1
      %x_ok_mid = scalar.andi %x_low_mid, %x_high_mid : i1
      %inside_mid = scalar.andi %y_ok_mid, %x_ok_mid : i1
      %loaded_mid = scf.if %inside_mid -> (vector<8xf16>) {
        %yi0_mid = index.sub %y0_mid, %c1 : index
        %xi0_mid = index.sub %x0_mid, %c1 : index
        %yi_mid = index.assume %yi0_mid [lt(%yi0_mid, %height)] : index
        %xi_mid = index.assume %xi0_mid [lt(%xi0_mid, %width)] : index
        %row_y0_mid = index.add %image_rows_mid, %yi_mid : index
        %row_yw_mid = index.mul %row_y0_mid, %width : index
        %in_row0_mid = index.add %row_yw_mid, %xi_mid : index
        %in_row_mid = index.assume %in_row0_mid [lt(%in_row0_mid, %in_rows_total)] : index
        %c_col_mid = index.assume %c_mid [le(%c_mid, %c_limit), mul(%c_mid, 8)] : index
        %v_mid = vector.load %a_view[%in_row_mid, %c_col_mid] : view<[%in_rows_total]x[%cin_stride]xf16> -> vector<8xf16>
        scf.yield %v_mid : vector<8xf16>
      } else {
        scf.yield %zero_f16x8 : vector<8xf16>
      }
      scf.yield %loaded_mid : vector<8xf16>
    } else {
      scf.yield %zero_f16x8 : vector<8xf16>
    }
    %source_n_mid = index.add %base_n, %row_mid : index
    %w_in_k_mid = index.cmp ult, %source_k_mid, %k_size : index
    %w_values_mid = scf.if %w_in_k_mid -> (vector<8xf16>) {
      %w_k_mid = index.assume %source_k_mid [lt(%source_k_mid, %k_size)] : index
      %w_loaded_mid = vector.load %w_view[%source_n_mid, %w_k_mid] : view<[%n_size]x[%k_size]xf16> -> vector<8xf16>
      scf.yield %w_loaded_mid : vector<8xf16>
    } else {
      scf.yield %zero_f16x8 : vector<8xf16>
    }
    %mid0, %mid1 = scf.for %k_half = [%c0 to %c32 step %c16](%half0 = %run0 : vector<8xf32>, %half1 = %run1 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>) unroll {
      %lhs = vector.fragment.load<lhs> %a_stage_view[%wave_row, %k_half] shape [%m, %k] : view<64x40xf16> -> vector<16xf16>
      %rhs0 = vector.fragment.load<rhs> %w_fragment_view[%k_half, %wave_col] shape [%k, %n] : view<32x64xf16, %w_fragment_layout> -> vector<16xf16>
      %rhs1 = vector.fragment.load<rhs> %w_fragment_view[%k_half, %wave_col1] shape [%k, %n] : view<32x64xf16, %w_fragment_layout> -> vector<16xf16>
      %out0 = vector.mma %lhs, %rhs0, %half0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %out1 = vector.mma %lhs, %rhs1, %half1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      scf.yield %out0, %out1 : vector<8xf32>, vector<8xf32>
    }
    vector.store %a_values_mid, %a_stage_view1[%load_row, %load_k] : vector<8xf16>, view<64x40xf16>
    vector.store %w_values_mid, %w_stage_view1[%load_row, %load_k] : vector<8xf16>, view<64x40xf16>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %k_end = index.add %k_base, %c64 : index
    %source_k_end = index.add %k_end, %load_k : index
    %row_end = index.add %load_row, %c0 : index
    %source_m_end = index.add %base_m, %row_end : index
    %m_in_range_end = index.cmp ult, %source_m_end, %m_size : index
    // Implicit im2col: this row of A is output pixel (b, yo, xo) and this
    // column is tap (dy, dx) of channel c. Zero outside the image and beyond
    // 9*Cin_pad. Same address arithmetic as kernels/im2col_f16.loom, which
    // is tested exactly against NumPy.
    %in_k_end = index.cmp ult, %source_k_end, %k_real : index
    %gathers_end = scalar.andi %m_in_range_end, %in_k_end : i1
    %a_values_end = scf.if %gathers_end -> (vector<8xf16>) {
      %ys_end = index.add %h_ys0, %c0 : index
      %xs_end = index.add %h_xs0, %c0 : index
      %image_rows_end = index.add %h_rows0, %c0 : index
      %tap_end = index.div %source_k_end, %cin_pad : index
      %c_end = index.rem %source_k_end, %cin_pad : index
      %dy_end = index.div %tap_end, %c3 : index
      %dx_end = index.rem %tap_end, %c3 : index
      // Clamp before subtracting: y0 = yo*stride + dy is never negative; the
      // tap is inside iff 1 <= y0 <= H, and only then is yi = y0 - 1 formed.
      %y0_end = index.add %ys_end, %dy_end : index
      %x0_end = index.add %xs_end, %dx_end : index
      %y_low_end = index.cmp uge, %y0_end, %c1 : index
      %y_high_end = index.cmp ule, %y0_end, %height : index
      %x_low_end = index.cmp uge, %x0_end, %c1 : index
      %x_high_end = index.cmp ule, %x0_end, %width : index
      %y_ok_end = scalar.andi %y_low_end, %y_high_end : i1
      %x_ok_end = scalar.andi %x_low_end, %x_high_end : i1
      %inside_end = scalar.andi %y_ok_end, %x_ok_end : i1
      %loaded_end = scf.if %inside_end -> (vector<8xf16>) {
        %yi0_end = index.sub %y0_end, %c1 : index
        %xi0_end = index.sub %x0_end, %c1 : index
        %yi_end = index.assume %yi0_end [lt(%yi0_end, %height)] : index
        %xi_end = index.assume %xi0_end [lt(%xi0_end, %width)] : index
        %row_y0_end = index.add %image_rows_end, %yi_end : index
        %row_yw_end = index.mul %row_y0_end, %width : index
        %in_row0_end = index.add %row_yw_end, %xi_end : index
        %in_row_end = index.assume %in_row0_end [lt(%in_row0_end, %in_rows_total)] : index
        %c_col_end = index.assume %c_end [le(%c_end, %c_limit), mul(%c_end, 8)] : index
        %v_end = vector.load %a_view[%in_row_end, %c_col_end] : view<[%in_rows_total]x[%cin_stride]xf16> -> vector<8xf16>
        scf.yield %v_end : vector<8xf16>
      } else {
        scf.yield %zero_f16x8 : vector<8xf16>
      }
      scf.yield %loaded_end : vector<8xf16>
    } else {
      scf.yield %zero_f16x8 : vector<8xf16>
    }
    %source_n_end = index.add %base_n, %row_end : index
    %w_in_k_end = index.cmp ult, %source_k_end, %k_size : index
    %w_values_end = scf.if %w_in_k_end -> (vector<8xf16>) {
      %w_k_end = index.assume %source_k_end [lt(%source_k_end, %k_size)] : index
      %w_loaded_end = vector.load %w_view[%source_n_end, %w_k_end] : view<[%n_size]x[%k_size]xf16> -> vector<8xf16>
      scf.yield %w_loaded_end : vector<8xf16>
    } else {
      scf.yield %zero_f16x8 : vector<8xf16>
    }
    %next0, %next1 = scf.for %k_half = [%c0 to %c32 step %c16](%half0 = %mid0 : vector<8xf32>, %half1 = %mid1 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>) unroll {
      %lhs = vector.fragment.load<lhs> %a_stage_view1[%wave_row, %k_half] shape [%m, %k] : view<64x40xf16> -> vector<16xf16>
      %rhs0 = vector.fragment.load<rhs> %w_fragment_view1[%k_half, %wave_col] shape [%k, %n] : view<32x64xf16, %w_fragment_layout> -> vector<16xf16>
      %rhs1 = vector.fragment.load<rhs> %w_fragment_view1[%k_half, %wave_col1] shape [%k, %n] : view<32x64xf16, %w_fragment_layout> -> vector<16xf16>
      %out0 = vector.mma %lhs, %rhs0, %half0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %out1 = vector.mma %lhs, %rhs1, %half1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      scf.yield %out0, %out1 : vector<8xf32>, vector<8xf32>
    }
    vector.store %a_values_end, %a_stage_view[%load_row, %load_k] : vector<8xf16>, view<64x40xf16>
    vector.store %w_values_end, %w_stage_view[%load_row, %load_k] : vector<8xf16>, view<64x40xf16>
    scf.yield %next0, %next1 : vector<8xf32>, vector<8xf32>
  }

  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  // Publish through LDS: each lane takes two vector4 slices of the 16x16 tile.
  %publish_row0 = index.div %lane, %c4 : index
  %publish_row1 = index.add %publish_row0, %c8 : index
  %publish_col_group = index.rem %lane, %c4 : index
  %publish_col = index.mul %publish_col_group, %c4 : index

  scf.for %fragment = [%c0 to %c2 step %c1] {
    %is_second = index.cmp eq, %fragment, %c1 : index
    %chosen = scf.select %is_second, %acc1, %acc0 : vector<8xf32>
    vector.fragment.store<result> %chosen, %result_view[%c0, %c0] shape [%m, %n] : vector<8xf32>, view<16x16xf32>
    kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)

    %fragment_col_offset = index.mul %fragment, %c16 : index
    %tile_col = index.add %wave_col, %fragment_col_offset : index
    %out_col_local = index.add %tile_col, %publish_col : index
    %out_col = index.add %base_n, %out_col_local : index
    %bias_values = vector.load %bias_view[%out_col] : view<[%n_size]xf32> -> vector<4xf32>

    scf.for %half = [%c0 to %c2 step %c1] {
      %row_offset = index.mul %half, %c8 : index
      %publish_row = index.add %publish_row0, %row_offset : index
      %values = vector.load %result_view[%publish_row, %publish_col] : view<16x16xf32> -> vector<4xf32>
      %biased = vector.addf %values, %bias_values : vector<4xf32>
      %row_local = index.add %wave_row, %publish_row : index
      %out_row = index.add %base_m, %row_local : index
      %writes = index.cmp ult, %out_row, %m_size : index
      scf.if %writes {
        %bounded = index.assume %out_row [lt(%out_row, %m_size)] : index
        %narrow = vector.fptrunc %biased : vector<4xf32> to vector<4xf16>
        vector.store %narrow, %c_view[%bounded, %out_col] : vector<4xf16>, view<[%m_size]x[%n_size]xf16>
      }
    }
    kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  }
  kernel.return
}
