    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

    %next0 = scf.for %k_half = [%c0 to %c32 step %c16](%half0 = %run0 : vector<8xf32>) -> (vector<8xf32>) unroll {
      %lhs = vector.fragment.load<lhs> %a_stage_view[%wave_row, %k_half] shape [%m, %k] : view<64x40xf16> -> vector<16xf16>
      %rhs0 = vector.fragment.load<rhs> %w_fragment_view[%k_half, %wave_col] shape [%k, %n] : view<32x32xf16, %w_fragment_layout> -> vector<16xf16>
      %out0 = vector.mma %lhs, %rhs0, %half0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      scf.yield %out0 : vector<8xf32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %next0 : vector<8xf32>
