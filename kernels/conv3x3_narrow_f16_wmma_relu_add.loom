// Input height/width (NHWC, Cin_stride channels), stride, gather width and row
// stride. k_size is K_pad = 9*Cin_pad rounded to 32; the gather zero-fills the tail.
config.decl @scrfd.conv3x3_narrow_f16_wmma_relu_add.height : %value: index where [range(%value, 2, 4096), mul(%value, 2)]

config.decl @scrfd.conv3x3_narrow_f16_wmma_relu_add.width : %value: index where [range(%value, 2, 4096), mul(%value, 2)]

config.decl @scrfd.conv3x3_narrow_f16_wmma_relu_add.stride : %value: index where [range(%value, 1, 2)]

config.decl @scrfd.conv3x3_narrow_f16_wmma_relu_add.cin_pad : %value: index where [range(%value, 4, 1024), mul(%value, 4)]

// Physical channel stride of the input rows: the width its producer wrote,
// which is that conv's Cout_pad (64-aligned), or 4 for the stem's converted
// image. The gather reads only c < cin_pad inside each row, so the MMA work is
// 9*cin_pad, not 9*cin_stride -- for an 88-channel tensor stored 128 wide that
// is the difference between K=800 and K=1152.
config.decl @scrfd.conv3x3_narrow_f16_wmma_relu_add.cin_stride : %value: index where [range(%value, 4, 1024), mul(%value, 4)]

config.decl @scrfd.conv3x3_narrow_f16_wmma_relu_add.k_size : %value: index where [range(%value, 32, 16384), mul(%value, 32)]

config.decl @scrfd.conv3x3_narrow_f16_wmma_relu_add.n_size : %value: index where [range(%value, 32, 8192), mul(%value, 32)]

kernel.def target(@scrfd_conv3x3_narrow_f16_wmma_relu_add_gfx11) export("scrfd_conv3x3_narrow_f16_wmma_relu_add") @scrfd_conv3x3_narrow_f16_wmma_relu_add(%m_size: index) {
  %c1 = index.constant 1 : index
  %c63 = index.constant 63 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %n_size0 = config.get @scrfd.conv3x3_narrow_f16_wmma_relu_add.n_size : index
  %m_rounded = index.add %m_size, %c63 : index
  %m_tiles = index.div %m_rounded, %c64 : index
  %c32_cfg = index.constant 32 : index
  %n_tiles = index.div %n_size0, %c32_cfg : index
  kernel.launch.config workgroups(%n_tiles, %m_tiles, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%m_size: index, %a: buffer, %w: buffer, %bias: buffer, %c: buffer, %residual: buffer) {
  %k_size0 = config.get @scrfd.conv3x3_narrow_f16_wmma_relu_add.k_size : index
  %n_size0 = config.get @scrfd.conv3x3_narrow_f16_wmma_relu_add.n_size : index
  %k_size = index.assume %k_size0 [range(%k_size0, 32, 8192), mul(%k_size0, 32)] : index
  %n_size = index.assume %n_size0 [range(%n_size0, 32, 8192), mul(%n_size0, 32)] : index
  %height = config.get @scrfd.conv3x3_narrow_f16_wmma_relu_add.height : index
  %width = config.get @scrfd.conv3x3_narrow_f16_wmma_relu_add.width : index
  %stride = config.get @scrfd.conv3x3_narrow_f16_wmma_relu_add.stride : index
  %cin_pad = config.get @scrfd.conv3x3_narrow_f16_wmma_relu_add.cin_pad : index
  %cin_stride = config.get @scrfd.conv3x3_narrow_f16_wmma_relu_add.cin_stride : index

  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c40 = index.constant 40 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %true_pred = scalar.constant 1 : i1
  %a_stage_bytes = index.constant 5120 : offset
  %w_stage_bytes = index.constant 2560 : offset
  %result_stage_bytes = index.constant 8192 : offset
  %wave_result_bytes = index.constant 1024 : offset
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %zero_f32x8 = vector.constant 0.0 : vector<8xf32>
  %zero_f16x4 = vector.constant 0.0 : vector<4xf16>
  %zero_f32x4 = vector.constant 0.0 : vector<4xf32>

  %tile_n_id = kernel.workgroup.id<x> : index
  %tile_m_id = kernel.workgroup.id<y> : index
  %workitem = kernel.workitem.id<x> : index
  %subgroup0 = kernel.subgroup.id : index
  %subgroup = index.assume %subgroup0 [range(%subgroup0, 0, 7)] : index
  %lane = kernel.subgroup.lane.id : index

  %wave_m = index.div %subgroup, %c2 : index
  %wave_n = index.rem %subgroup, %c2 : index
  %wave_row = index.mul %wave_m, %c16 : index
  %wave_col = index.mul %wave_n, %c16 : index
  %base_m = index.mul %tile_m_id, %c64 : index
  %base_n = index.mul %tile_n_id, %c32 : index

  %a_global = buffer.assume.memory_space<global> %a : buffer
  %w_global = buffer.assume.memory_space<global> %w : buffer
  %bias_global = buffer.assume.memory_space<global> %bias : buffer
  %c_global = buffer.assume.memory_space<global> %c : buffer
  // A is the NHWC input [B*H*W][Cin_stride]; the [M][K] matrix is never formed.
  // M = B*Ho*Wo is a launch argument -- bounded here, never with `where`.
  %c3 = index.constant 3 : index
  %c9 = index.constant 9 : index
  %m_bounded = index.assume %m_size [range(%m_size, 1, 16777216)] : index
  %ho = index.div %height, %stride : index
  %wo = index.div %width, %stride : index
  %plane = index.mul %ho, %wo : index
  %images = index.div %m_bounded, %plane : index
  %in_rows_per_image = index.mul %height, %width : index
  %in_rows_total = index.mul %images, %in_rows_per_image : index
  %k_real = index.mul %cin_pad, %c9 : index
  %c_limit = index.sub %cin_pad, %c4 : index
  %a_view = buffer.view %a_global[%c0_offset] : buffer -> view<[%in_rows_total]x[%cin_stride]xf16>
  %w_view = buffer.view %w_global[%c0_offset] : buffer -> view<[%n_size]x[%k_size]xf16>
  %bias_view = buffer.view %bias_global[%c0_offset] : buffer -> view<[%n_size]xf32>
  %c_view = buffer.view %c_global[%c0_offset] : buffer -> view<[%m_size]x[%n_size]xf16>
  %residual_global = buffer.assume.memory_space<global> %residual : buffer
  %residual_view = buffer.view %residual_global[%c0_offset] : buffer -> view<[%m_size]x[%n_size]xf16>

  %a_stage = buffer.alloca<workgroup> align(16) %a_stage_bytes : buffer
  %w_stage = buffer.alloca<workgroup> align(16) %w_stage_bytes : buffer
  %result_stage = buffer.alloca<workgroup> align(16) %result_stage_bytes : buffer
  %a_stage_view = buffer.view %a_stage[%c0_offset] : buffer -> view<64x40xf16>
  %w_stage_view = buffer.view %w_stage[%c0_offset] : buffer -> view<32x40xf16>
  // The rhs fragment wants logical [k][n]; the staged weight tile is physically
  // [n][k] with a 40-element row, so a strided layout reads it transposed.
  %w_fragment_layout = encoding.layout.strided [1, %c40] : encoding<layout>
  %w_fragment_view = buffer.view %w_stage[%c0_offset] : buffer -> view<32x32xf16, %w_fragment_layout>
  %wave_result_offset = index.scale %subgroup, %wave_result_bytes : index, offset -> offset
  %result_view = buffer.view %result_stage[%wave_result_offset] : buffer -> view<16x16xf32>

  %load_packet = index.rem %workitem, %c8 : index
  %load_k = index.mul %load_packet, %c4 : index
  %load_row0 = index.div %workitem, %c8 : index
  %load_row = index.assume %load_row0 [range(%load_row0, 0, 31)] : index
  %load_row_high = index.add %load_row, %c32 : index

  %acc_init0 = vector.fragment<init> %zero_f32x8 shape [%m, %n] : vector<8xf32>

  %acc0 = scf.for %k_base = [%c0 to %k_size step %c32](%run0 = %acc_init0 : vector<8xf32>) -> (vector<8xf32>) {
    %source_k = index.add %k_base, %load_k : index
    scf.for %half = [%c0 to %c2 step %c1] {
      %row_offset = index.mul %half, %c32 : index
      %row = index.add %load_row, %row_offset : index
      %source_m = index.add %base_m, %row : index
      %m_in_range = index.cmp ult, %source_m, %m_size : index
      // Implicit im2col: this row of A is output pixel (b, yo, xo) and this
      // column is tap (dy, dx) of channel c. Zero outside the image and beyond
      // 9*Cin_pad. Same address arithmetic as kernels/im2col_f16.loom, which
      // is tested exactly against NumPy.
      %in_k = index.cmp ult, %source_k, %k_real : index
      %gathers = scalar.andi %m_in_range, %in_k : i1
      %a_values = scf.if %gathers -> (vector<4xf16>) {
        %m_b = index.assume %source_m [lt(%source_m, %m_bounded)] : index
        %image = index.div %m_b, %plane : index
        %pixel = index.rem %m_b, %plane : index
        %yo = index.div %pixel, %wo : index
        %xo = index.rem %pixel, %wo : index
        %tap = index.div %source_k, %cin_pad : index
        %c = index.rem %source_k, %cin_pad : index
        %dy = index.div %tap, %c3 : index
        %dx = index.rem %tap, %c3 : index
        // Clamp before subtracting: y0 = yo*stride + dy is never negative; the
        // tap is inside iff 1 <= y0 <= H, and only then is yi = y0 - 1 formed.
        %ys = index.mul %yo, %stride : index
        %y0 = index.add %ys, %dy : index
        %xs = index.mul %xo, %stride : index
        %x0 = index.add %xs, %dx : index
        %y_low = index.cmp uge, %y0, %c1 : index
        %y_high = index.cmp ule, %y0, %height : index
        %x_low = index.cmp uge, %x0, %c1 : index
        %x_high = index.cmp ule, %x0, %width : index
        %y_ok = scalar.andi %y_low, %y_high : i1
        %x_ok = scalar.andi %x_low, %x_high : i1
        %inside = scalar.andi %y_ok, %x_ok : i1
        %loaded = scf.if %inside -> (vector<4xf16>) {
